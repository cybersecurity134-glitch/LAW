{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control, preferences, and FCM tokens",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["admin", "contributor", "viewer"] },
        "accentColor": { "type": "string", "maxLength": 50 },
        "theme": { "type": "string", "enum": ["day", "night", "system"] },
        "fcmTokens": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "email", "role", "createdAt"]
    },
    "News": {
      "title": "News",
      "description": "Verified startup news item with category-specific metadata and real source integrity",
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": ["new_startup", "govt_scheme", "funding_option", "investment", "event", "problem_fix"]
        },
        "title": { "type": "string", "minLength": 5, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 500 },
        "body": { "type": "string", "minLength": 20, "maxLength": 10000 },
        "imageUrls": { "type": "array" },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "sourceName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "sourceUrl": { "type": "string", "pattern": "^https://.*", "maxLength": 500 },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "unpublished"]
        },
        "verifiedBy": { "type": "string", "maxLength": 128 },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "location": { "type": "string", "maxLength": 200 },
        "investorName": { "type": "string", "maxLength": 100 },
        "startupName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "string", "maxLength": 50 },
        "round": { "type": "string", "maxLength": 50 },
        "issuingBody": { "type": "string", "maxLength": 150 },
        "eligibility": { "type": "string", "maxLength": 500 },
        "deadline": { "type": "string", "maxLength": 100 },
        "problem": { "type": "string", "maxLength": 1000 },
        "solution": { "type": "string", "maxLength": 1000 }
      },
      "required": ["category", "title", "summary", "body", "authorId", "authorName", "sourceName", "sourceUrl", "status", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Direct networking chat between two participants",
      "type": "object",
      "properties": {
        "participants": { "type": "array" },
        "participantsKey": { "type": "string", "maxLength": 260 },
        "lastMessage": { "type": "string", "maxLength": 1000 },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "lastSenderId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "unreadCounts": { "type": "object" }
      },
      "required": ["participants", "participantsKey", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Immutable chat message sent by a participant",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "readBy": { "type": "array" }
      },
      "required": ["senderId", "text", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System security audit record generated strictly by Cloud Functions",
      "type": "object",
      "properties": {
        "actorId": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 100 },
        "targetId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "object" }
      },
      "required": ["actorId", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profile records with role and preferences"
    },
    "/news/{newsId}": {
      "schema": "News",
      "description": "Real startup news, govt schemes, funding options, and verified submissions"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Direct 1-on-1 networking conversations"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Immutable chat messages under conversation"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable system audit trail, admin-read only"
    }
  }
}

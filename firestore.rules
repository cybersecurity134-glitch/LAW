rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.email != null && request.auth.token.email == 'cybersecurity134@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isContributor() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'contributor'
      );
    }

    function hasUploadPermission() {
      return isAdmin() || (
        isContributor() &&
        request.auth.token.uploadPermissionUntil is number &&
        request.auth.token.uploadPermissionUntil > request.time.toMillis()
      );
    }

    function isValidUrl(url) {
      return url is string && url.size() >= 8 && url.size() <= 500 && (url.matches('^https://.*') || url.matches('^http://.*'));
    }

    function isValidCategory(cat) {
      return cat in ['new_startup', 'govt_scheme', 'funding_option', 'investment', 'event', 'problem_fix'];
    }

    function isValidNewsStatus(s) {
      return s in ['pending', 'approved', 'rejected', 'unpublished'];
    }

    function isValidUser(data) {
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 150 &&
             data.role in ['admin', 'contributor', 'viewer'] &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() <= 50)) &&
             (!('theme' in data) || data.theme in ['day', 'night', 'system']) &&
             (!('fcmTokens' in data) || (data.fcmTokens is list && data.fcmTokens.size() <= 20));
    }

    function isValidNews(data) {
      return isValidCategory(data.category) &&
             isValidNewsStatus(data.status) &&
             data.title is string && data.title.size() >= 5 && data.title.size() <= 200 &&
             data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 1000 &&
             data.body is string && data.body.size() >= 20 && data.body.size() <= 20000 &&
             data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
             data.sourceName is string && data.sourceName.size() >= 2 && data.sourceName.size() <= 100 &&
             isValidUrl(data.sourceUrl) &&
             (!('imageUrls' in data) || (data.imageUrls is list && data.imageUrls.size() <= 10));
    }

    function isValidChat(data) {
      return data.participants is list && data.participants.size() == 2 &&
             data.participantsKey is string && data.participantsKey.size() <= 260;
    }

    // -------------------------------------------------------------------------
    // Users Collection
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      
      // New users register as "viewer" only
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidUser(incoming()) &&
                       incoming().role == 'viewer' &&
                       incoming().createdAt == request.time;

      // Users update their own safe profile fields (never role)
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId &&
          isValidUser(incoming()) &&
          incoming().role == existing().role &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'accentColor', 'theme', 'lastSeenAt', 'fcmTokens'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // News Collection
    // -------------------------------------------------------------------------
    match /news/{newsId} {
      // Anyone signed in (or guests viewing approved) can read approved news
      // Author can read own pending/rejected; Admin can read all
      allow get: if (existing().status == 'approved') ||
                    (isSignedIn() && (existing().authorId == request.auth.uid || isAdmin()));

      allow list: if (resource.data.status == 'approved') ||
                     (isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()));

      // Contributors with valid upload permission can create pending news
      allow create: if hasUploadPermission() &&
                       incoming().authorId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().createdAt == request.time &&
                       isValidNews(incoming());

      // Contributors can update their own submissions ONLY while status is 'pending'
      // Admins can update any news (e.g. approve/reject/review)
      allow update: if isSignedIn() && (
        (isAdmin() && isValidNews(incoming())) ||
        (
          isContributor() &&
          existing().authorId == request.auth.uid &&
          existing().status == 'pending' &&
          incoming().status == 'pending' &&
          incoming().authorId == existing().authorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isValidNews(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'summary', 'body', 'category', 'imageUrls', 'sourceName', 'sourceUrl',
            'updatedAt', 'startDate', 'endDate', 'location', 'investorName', 'startupName',
            'amount', 'round', 'issuingBody', 'eligibility', 'deadline', 'problem', 'solution'
          ])
        )
      );

      // Contributors can delete only their own pending news. Admins can delete any news.
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (isContributor() && existing().authorId == request.auth.uid && existing().status == 'pending')
      );
    }

    // -------------------------------------------------------------------------
    // Chats Collection
    // -------------------------------------------------------------------------
    match /chats/{chatId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;

      // Creation enforces 2 participants and includes caller
      allow create: if isSignedIn() &&
                       request.auth.uid in incoming().participants &&
                       incoming().createdAt == request.time &&
                       isValidChat(incoming());

      // Update message preview / unread metadata
      allow update: if isSignedIn() &&
                       request.auth.uid in existing().participants &&
                       incoming().participants == existing().participants &&
                       incoming().participantsKey == existing().participantsKey &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'lastMessage', 'lastMessageAt', 'lastSenderId', 'unreadCounts'
                       ]);

      allow delete: if false;

      // -----------------------------------------------------------------------
      // Chat Messages Subcollection
      // -----------------------------------------------------------------------
      match /messages/{messageId} {
        allow get, list: if isSignedIn() &&
                            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Messages are immutable after creation. Caller must be sender.
        allow create: if isSignedIn() &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         incoming().senderId == request.auth.uid &&
                         incoming().createdAt == request.time &&
                         incoming().text is string &&
                         incoming().text.size() > 0 &&
                         incoming().text.size() <= 2000 &&
                         (!('readBy' in incoming()) || incoming().readBy is list);

        // Allow updating only readBy array for read receipts
        allow update: if isSignedIn() &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['readBy']) &&
                         incoming().readBy is list &&
                         incoming().readBy.hasAll(existing().readBy);

        allow delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Audit Logs Collection (Cloud Functions write, Admin read only)
    // -------------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Config Collection (Hidden security config, NO client access)
    // -------------------------------------------------------------------------
    match /config/{configId} {
      allow read, write: if false;
    }
  }
}
